# Domain URL Website (Canonical URL & Google Search Console)
NEXT_PUBLIC_SITE_URL=https://rembg.vercel.app

# URL Backend Hugging Face ZeroGPU (Default: https://ilhamdev-rembg.hf.space)
NEXT_PUBLIC_HF_SPACE_URL=https://ilhamdev-rembg.hf.space

# Hugging Face Access Token untuk autentikasi ZeroGPU quota (bebas batas anonymous runs)
# Dapatkan token gratis di: https://huggingface.co/settings/tokens
# Jika memiliki lebih dari 1 token, bisa dipisah tanda koma (HF_TOKENS=token1,token2) untuk round-robin/random quota balancing
HF_TOKEN=
# HF_TOKENS=

# Cloudflare Turnstile Configuration
# Dapatkan Site Key dan Secret Key gratis di Cloudflare Dashboard -> Turnstile
# Catatan: Jika dikosongkan saat dev lokal, sistem otomatis menggunakan Official Dummy Test Key Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Search Console Verification Token (Opsional, jika menggunakan metode HTML tag)
# NEXT_PUBLIC_GSC_VERIFICATION=

# Web Analytics (Opsional: Google Analytics Measurement ID, misal: G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=
